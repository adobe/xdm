                  "meta:descriptionId": "conversion-metrics##xdm:leads##description##11451"
                },
                "xdm:qualifiedLeads": {
                  "type": "integer",
                  "title": "Qualified Leads",
                  "description": "Number of qualified/validated leads",
                  "minimum": 0,
                  "meta:titleId": "conversion-metrics##xdm:qualifiedLeads##title##26961",
                  "meta:descriptionId": "conversion-metrics##xdm:qualifiedLeads##description##85411"
                },
                "xdm:costPerLead": {
                  "type": "number",
                  "title": "Cost Per Lead",
                  "description": "Average cost per lead",
                  "minimum": 0,
                  "meta:titleId": "conversion-metrics##xdm:costPerLead##title##74371",
                  "meta:descriptionId": "conversion-metrics##xdm:costPerLead##description##73871"
                },
                "xdm:leadFormOpens": {
                  "type": "integer",
                  "title": "Lead Form Opens",
                  "description": "Number of times lead form was opened",
                  "minimum": 0,
                  "meta:titleId": "conversion-metrics##xdm:leadFormOpens##title##16321",
                  "meta:descriptionId": "conversion-metrics##xdm:leadFormOpens##description##75101"
                },
                "xdm:leadFormSubmissions": {
                  "type": "integer",
                  "title": "Lead Form Submissions",
                  "description": "Number of lead form submissions",
                  "minimum": 0,
                  "meta:titleId": "conversion-metrics##xdm:leadFormSubmissions##title##42291",
                  "meta:descriptionId": "conversion-metrics##xdm:leadFormSubmissions##description##70571"
                },
                "xdm:leadFormCompletionRate": {
                  "type": "number",
                  "title": "Lead Form Completion Rate",
                  "description": "Percentage of opened forms that were submitted",
                  "minimum": 0,
                  "maximum": 1,
                  "meta:titleId": "conversion-metrics##xdm:leadFormCompletionRate##title##97931",
                  "meta:descriptionId": "conversion-metrics##xdm:leadFormCompletionRate##description##29241"
                }
