                "xdm:leadFormCompletionRate": {
                  "type": "number",
                  "title": "Lead Form Completion Rate",
                  "description": "Percentage of opened forms that were submitted",
                  "minimum": 0,
                  "maximum": 1,
                  "meta:titleId": "conversion-metrics##xdm:leadFormCompletionRate##title##39241",
                  "meta:descriptionId": "conversion-metrics##xdm:leadFormCompletionRate##description##20421"
                }
