  "$id": "https://ns.adobe.com/xdm/mixins/healthcare-plan-details",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Healthcare Plan Details",
  "type": "object",
  "meta:extensible": true,
  "meta:abstract": true,
  "meta:tags": {
    "industry": ["healthcare_services"]
  },
  "meta:intendedToExtend": ["https://ns.adobe.com/xdm/classes/plan"],
  "description": "Patient medical plan details such as network, type, and active status.",
  "definitions": {
    "health-plan-details": {
      "properties": {
        "xdm:healthcarePlanDetails": {
          "title": "Healthcare Plan Details",
          "description": "Information about the healthcare plan.",
          "type": "object",
          "properties": {
            "xdm:payerID": {
              "title": "Payer ID",
              "type": "string",
              "description": "Unique identifier of the payer. This is the insurance provider of the plan.",
              "meta:titleId": "healthcare-plan-details##xdm:payerID##title##31301",
              "meta:descriptionId": "healthcare-plan-details##xdm:payerID##description##26061"
            },
            "xdm:payerName": {
              "title": "Payer Name",
              "type": "string",
              "description": "Name of the payer. This is the insurance provider of the plan.",
              "meta:titleId": "healthcare-plan-details##xdm:payerName##title##19381",
              "meta:descriptionId": "healthcare-plan-details##xdm:payerName##description##31351"
            },
            "xdm:targetOwnerType": {
              "title": "Target Owner Type",
              "type": "string",
              "description": " The type of owner a plan is for. Examples are individual, group, organization, etc.",
              "meta:titleId": "healthcare-plan-details##xdm:targetOwnerType##title##44051",
              "meta:descriptionId": "healthcare-plan-details##xdm:targetOwnerType##description##93161"
            },
            "xdm:isActive": {
              "title": "Is Active",
              "type": "boolean",
              "description": "Indicates whether the plan is active.",
              "meta:titleId": "healthcare-plan-details##xdm:isActive##title##20991",
              "meta:descriptionId": "healthcare-plan-details##xdm:isActive##description##20311"
            },
            "xdm:networkDetails": {
              "type": "array",
              "title": "Network Details",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "xdm:networkID": {
                    "title": "Network Identifier",
                    "type": "string",
                    "description": "The insurer-specific identifier for the insurer-defined network of providers to which the beneficiary may seek treatment which will be covered at the 'in-network' rate.",
                    "meta:titleId": "healthcare-plan-details##xdm:networkID##title##55451",
                    "meta:descriptionId": "healthcare-plan-details##xdm:networkID##description##9371"
                  },
                  "xdm:networkName": {
                    "title": "Network Name",
                    "type": "string",
                    "description": "The insurer-specific identifier for the insurer-defined network of providers to which the beneficiary may seek treatment which will be covered at the 'in-network' rate.",
                    "meta:titleId": "healthcare-plan-details##xdm:networkName##title##29771",
                    "meta:descriptionId": "healthcare-plan-details##xdm:networkName##description##17561"
                  }
                }
              },
              "meta:titleId": "healthcare-plan-details##xdm:networkDetails##title##86811"
            },
            "xdm:planType": {
              "title": "Plan Type",
              "type": "string",
              "meta:enum": {
                "hmo": "HMO",
                "epo": "PPO",
                "pos": "POS",
                "hdhp": "HDHP"
              },
              "description": "This indicates if the plan is primary, secondary or a tertiary plan.",
              "meta:titleId": "healthcare-plan-details##xdm:planType##title##56721",
              "meta:descriptionId": "healthcare-plan-details##xdm:planType##description##9981",
              "meta:enumId": {
                "hmo": "healthcare-plan-details##xdm:planType##meta:enum##hmo##29491",
                "epo": "healthcare-plan-details##xdm:planType##meta:enum##epo##51291",
                "pos": "healthcare-plan-details##xdm:planType##meta:enum##pos##57931",
                "hdhp": "healthcare-plan-details##xdm:planType##meta:enum##hdhp##36401"
              }
            },
            "xdm:planLevel": {
              "title": "Plan Level",
              "type": "string",
              "meta:enum": {
                "primary": "Primary",
                "secondary": "Secondary",
                "tertiary": "Tertiary",
                "quaternary": "Quaternary"
              },
              "description": "This indicates if the plan is primary, secondary, tertiary etc.",
              "meta:titleId": "healthcare-plan-details##xdm:planLevel##title##26791",
              "meta:descriptionId": "healthcare-plan-details##xdm:planLevel##description##63221",
              "meta:enumId": {
                "primary": "healthcare-plan-details##xdm:planLevel##meta:enum##primary##81771",
                "secondary": "healthcare-plan-details##xdm:planLevel##meta:enum##secondary##21321",
                "tertiary": "healthcare-plan-details##xdm:planLevel##meta:enum##tertiary##67121",
                "quaternary": "healthcare-plan-details##xdm:planLevel##meta:enum##quaternary##35151"
              }
            },
            "xdm:coverageType": {
              "title": "Coverage Type",
              "type": "string",
              "meta:enum": {
                "medical": "Medical",
                "dental": "Dental",
                "vision": "Vision",
                "accident": "Accident"
              },
              "description": "Plan coverage type.",
              "meta:titleId": "healthcare-plan-details##xdm:coverageType##title##28291",
              "meta:descriptionId": "healthcare-plan-details##xdm:coverageType##description##3941",
              "meta:enumId": {
                "medical": "healthcare-plan-details##xdm:coverageType##meta:enum##medical##26301",
                "dental": "healthcare-plan-details##xdm:coverageType##meta:enum##dental##74511",
                "vision": "healthcare-plan-details##xdm:coverageType##meta:enum##vision##16381",
                "accident": "healthcare-plan-details##xdm:coverageType##meta:enum##accident##1221"
              }
            },
            "xdm:lastVerificationDate": {
              "title": "Last Verification Date",
              "type": "string",
              "format": "date-time",
              "description": "The date on which the plan was last verified.",
              "meta:titleId": "healthcare-plan-details##xdm:lastVerificationDate##title##48471",
              "meta:descriptionId": "healthcare-plan-details##xdm:lastVerificationDate##description##44041"
            }
          },
          "meta:titleId": "healthcare-plan-details##xdm:healthcarePlanDetails##title##72791",
          "meta:descriptionId": "healthcare-plan-details##xdm:healthcarePlanDetails##description##28491"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/health-plan-details"
    }
  ],
  "meta:status": "stable",
  "meta:titleId": "healthcare-plan-details##title##45731",
  "meta:descriptionId": "healthcare-plan-details##description##89161"
}
