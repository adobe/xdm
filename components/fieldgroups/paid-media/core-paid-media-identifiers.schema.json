              "type": "string",
              "title": "Portfolio ID",
              "description": "Portfolio identifier for grouping campaigns (Amazon Ads and similar platforms) within the network",
              "meta:titleId": "core-identifiers##xdm:portfolioID##title##11211",
              "meta:descriptionId": "core-identifiers##xdm:portfolioID##description##95211"
