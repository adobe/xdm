            "xdm:assetGUID": {
              "type": "string",
              "title": "Asset GUID",
              "description": "Unique identifier for creative assets (images, videos, etc.) across all networks",
              "meta:titleId": "core-identifiers##xdm:assetGUID##title##61661",
              "meta:descriptionId": "core-identifiers##xdm:assetGUID##description##89791"
            },
