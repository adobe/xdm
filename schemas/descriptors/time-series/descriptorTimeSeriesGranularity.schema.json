  "$id": "https://ns.adobe.com/xdm/common/descriptors/descriptorTimeSeriesGranularity",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Time-series Granularity Descriptor",
  "meta:extensible": false,
  "meta:extends": [
    "https://ns.adobe.com/xdm/common/desciptors/schemadescriptor"
  ],
  "meta:abstract": false,
  "type": "object",
  "description": "Defines the granularity of time-series/summary data.",
  "definitions": {
    "descriptorTimeSeriesGranularity": {
      "properties": {
        "@type": {
          "type": "string",
          "const": "xdm:descriptorTimeSeriesGranularity"
        },
        "xdm:granularity": {
          "title": "Granularity",
          "description": "Granularity of the time-series / summary data.  The schema's `xdm:timestamp` field is the first timestamp in a period of this granularity.",
          "type": "string",
          "default": "day",
          "enum": ["hour", "day", "week", "month", "quarter", "year"],
          "meta:enum": {
            "hour": "Hourly data",
            "day": "Daily data",
            "week": "Weekly data",
            "month": "Monthly data",
            "quarter": "Quarterly data",
            "year": "Yearly data"
          },
          "meta:titleId": "descriptorTimeSeriesGranularity##xdm:granularity##title##56551",
          "meta:descriptionId": "descriptorTimeSeriesGranularity##xdm:granularity##description##79851",
          "meta:enumId": {
            "hour": "descriptorTimeSeriesGranularity##xdm:granularity##meta:enum##hour##92971",
            "day": "descriptorTimeSeriesGranularity##xdm:granularity##meta:enum##day##47841",
            "week": "descriptorTimeSeriesGranularity##xdm:granularity##meta:enum##week##69051",
            "month": "descriptorTimeSeriesGranularity##xdm:granularity##meta:enum##month##47471",
            "quarter": "descriptorTimeSeriesGranularity##xdm:granularity##meta:enum##quarter##61671",
            "year": "descriptorTimeSeriesGranularity##xdm:granularity##meta:enum##year##97881"
          }
        },
        "xdm:ianaTimezone": {
          "title": "Iana Timezone",
          "type": "string",
          "description": "Timezone of the time-series / summary data as a standard timezone string. https://en.wikipedia.org/wiki/List_of_tz_database_time_zones. The default is UTC.",
          "meta:titleId": "descriptorTimeSeriesGranularity##xdm:ianaTimezone##title##3501",
          "meta:descriptionId": "descriptorTimeSeriesGranularity##xdm:ianaTimezone##description##39461"
        }
      },
      "required": ["xdm:granularity"]
    }
  },
  "allOf": [
    {
      "$ref": "https://ns.adobe.com/xdm/common/descriptors/schemadescriptor#/definitions/descriptor"
    },
    {
      "$ref": "#/definitions/descriptorTimeSeriesGranularity"
    }
  ],
  "meta:status": "stable",
  "meta:createdDate": "2022-03-28",
  "meta:titleId": "descriptorTimeSeriesGranularity##title##26941",
  "meta:descriptionId": "descriptorTimeSeriesGranularity##description##51361"
}
