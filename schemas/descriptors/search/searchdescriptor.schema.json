  "$id": "https://ns.adobe.com/xdm/common/descriptors/searchdescriptor",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Search Descriptor",
  "meta:extensible": false,
  "meta:extends": [
    "https://ns.adobe.com/xdm/common/descriptors/schemadescriptor#/definitions/descriptor"
  ],
  "meta:abstract": false,
  "type": "object",
  "description": "Describes search annotations for specific properties of the schemas.",
  "definitions": {
    "searchdescriptor": {
      "properties": {
        "search:indexed": {
          "title": "Indexed",
          "type": "boolean",
          "description": "Whether the property is indexable and searchable.",
          "default": false,
          "meta:titleId": "searchdescriptor##search:indexed##title##89341",
          "meta:descriptionId": "searchdescriptor##search:indexed##description##32251"
        },
        "search:filterable": {
          "title": "Filterable",
          "type": "boolean",
          "description": "Whether the property can be used as a filter in search queries.",
          "default": false,
          "meta:titleId": "searchdescriptor##search:filterable##title##7971",
          "meta:descriptionId": "searchdescriptor##search:filterable##description##41761"
        },
        "search:store": {
          "title": "Stored",
          "type": "string",
          "description": "Whether the property value is stored in, and therefore can be retrieved from, the index.",
          "meta:enum": {
            "notStored": "notStored",
            "stored": "stored",
            "storedAndFetchByDefault": "storedAndFetchByDefault"
          },
          "default": "notStored",
          "meta:titleId": "searchdescriptor##search:store##title##78701",
          "meta:descriptionId": "searchdescriptor##search:store##description##76781",
          "meta:enumId": {
            "notStored": "searchdescriptor##search:store##meta:enum##notStored##90591",
            "stored": "searchdescriptor##search:store##meta:enum##stored##98461",
            "storedAndFetchByDefault": "searchdescriptor##search:store##meta:enum##storedAndFetchByDefault##77201"
          }
        },
        "search:sort": {
          "title": "Sort Type",
          "type": "string",
          "description": "Whether and how search results can be sorted on this property.",
          "meta:enum": {
            "notSortable": "notSortable",
            "sorted": "sorted",
            "sortedCaseSensitive": "sortedCaseSensitive",
            "sortedCaseInsensitive": "sortedCaseInsensitive"
          },
          "default": "notSortable",
          "meta:titleId": "searchdescriptor##search:sort##title##73251",
          "meta:descriptionId": "searchdescriptor##search:sort##description##96751",
          "meta:enumId": {
            "notSortable": "searchdescriptor##search:sort##meta:enum##notSortable##75601",
            "sorted": "searchdescriptor##search:sort##meta:enum##sorted##8021",
            "sortedCaseSensitive": "searchdescriptor##search:sort##meta:enum##sortedCaseSensitive##63471",
            "sortedCaseInsensitive": "searchdescriptor##search:sort##meta:enum##sortedCaseInsensitive##79151"
          }
        },
        "search:analyzers": {
          "title": "Analyzers",
          "type": "array",
          "items": {
            "type": "string"
          },
          "meta:enum": {
            "noAnalysis": "noAnalysis",
            "standard": "standard",
            "langGeneric": "langGeneric",
            "langFr": "langFr",
            "langTh": "langTh",
            "langDe": "langDe",
            "langJa": "langJa",
            "langZh": "langZh",
            "startsWithDefaultAnalyzer": "startsWithDefaultAnalyzer",
            "startsWithWhiteSpaceAnalyzer": "startsWithWhiteSpaceAnalyzer",
            "fileName": "fileName",
            "fileNameExtension": "fileNameExtension"
          },
          "description": "A set of analyzers to be applied when indexing this property.",
          "default": "noAnalysis",
          "meta:titleId": "searchdescriptor##search:analyzers##title##89401",
          "meta:descriptionId": "searchdescriptor##search:analyzers##description##34701",
          "meta:enumId": {
            "noAnalysis": "searchdescriptor##search:analyzers##meta:enum##noAnalysis##871",
            "standard": "searchdescriptor##search:analyzers##meta:enum##standard##81031",
            "langGeneric": "searchdescriptor##search:analyzers##meta:enum##langGeneric##79341",
            "langFr": "searchdescriptor##search:analyzers##meta:enum##langFr##3151",
            "langTh": "searchdescriptor##search:analyzers##meta:enum##langTh##21571",
            "langDe": "searchdescriptor##search:analyzers##meta:enum##langDe##53681",
            "langJa": "searchdescriptor##search:analyzers##meta:enum##langJa##80801",
            "langZh": "searchdescriptor##search:analyzers##meta:enum##langZh##76771",
            "startsWithDefaultAnalyzer": "searchdescriptor##search:analyzers##meta:enum##startsWithDefaultAnalyzer##22681",
            "startsWithWhiteSpaceAnalyzer": "searchdescriptor##search:analyzers##meta:enum##startsWithWhiteSpaceAnalyzer##95721",
            "fileName": "searchdescriptor##search:analyzers##meta:enum##fileName##27061",
            "fileNameExtension": "searchdescriptor##search:analyzers##meta:enum##fileNameExtension##15761"
          }
        },
        "search:defaultAnalyzer": {
          "title": "Default analyzer",
          "type": "string",
          "description": "Default analyzer to be applied when search queries are made against this property.",
          "meta:enum": {
            "noAnalysis": "noAnalysis",
            "standard": "standard",
            "langGeneric": "langGeneric",
            "langFr": "langFr",
            "langTh": "langTh",
            "langDe": "langDe",
            "langJa": "langJa",
            "langZh": "langZh",
            "startsWithDefaultAnalyzer": "startsWithDefaultAnalyzer",
            "startsWithWhiteSpaceAnalyzer": "startsWithWhiteSpaceAnalyzer",
            "fileName": "fileName",
            "fileNameExtension": "fileNameExtension"
          },
          "default": "noAnalysis",
          "meta:titleId": "searchdescriptor##search:defaultAnalyzer##title##98641",
          "meta:descriptionId": "searchdescriptor##search:defaultAnalyzer##description##68811",
          "meta:enumId": {
            "noAnalysis": "searchdescriptor##search:defaultAnalyzer##meta:enum##noAnalysis##46491",
            "standard": "searchdescriptor##search:defaultAnalyzer##meta:enum##standard##3931",
            "langGeneric": "searchdescriptor##search:defaultAnalyzer##meta:enum##langGeneric##32971",
            "langFr": "searchdescriptor##search:defaultAnalyzer##meta:enum##langFr##26731",
            "langTh": "searchdescriptor##search:defaultAnalyzer##meta:enum##langTh##51541",
            "langDe": "searchdescriptor##search:defaultAnalyzer##meta:enum##langDe##66911",
            "langJa": "searchdescriptor##search:defaultAnalyzer##meta:enum##langJa##3291",
            "langZh": "searchdescriptor##search:defaultAnalyzer##meta:enum##langZh##42671",
            "startsWithDefaultAnalyzer": "searchdescriptor##search:defaultAnalyzer##meta:enum##startsWithDefaultAnalyzer##52401",
            "startsWithWhiteSpaceAnalyzer": "searchdescriptor##search:defaultAnalyzer##meta:enum##startsWithWhiteSpaceAnalyzer##67501",
            "fileName": "searchdescriptor##search:defaultAnalyzer##meta:enum##fileName##38811",
            "fileNameExtension": "searchdescriptor##search:defaultAnalyzer##meta:enum##fileNameExtension##56771"
          }
        }
      },
      "required": ["search:indexed"]
    }
  },
  "allOf": [
    {
      "$ref": "https://ns.adobe.com/xdm/common/descriptors/schemadescriptor#/definitions/descriptor"
    },
    {
      "$ref": "#/definitions/searchdescriptor"
    }
  ],
  "meta:status": "stable",
  "meta:createdDate": "2020-08-10",
