  "$id": "https://ns.adobe.com/xdm/channels/channel",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Experience Channel",
  "meta:extensible": true,
  "meta:abstract": true,
  "type": "object",
  "description": "There are multiple experience channels, each with different constraints on how content is delivered and how customer interaction can be observed and data collected. Within a channel, experiences can be delivered to specific locations. The locations and types of locations that exist in a channel differ from channel to channel.",
  "definitions": {
    "channel": {
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri-reference",
          "description": "The ID uniquely identifies the channel. Each specific experience channel defines a constant `@id`.",
          "meta:descriptionId": "channel##@id##description##68641"
        },
        "xdm:typeAtSource": {
          "type": "string",
          "description": "Customer defined custom channel name",
          "meta:descriptionId": "channel##xdm:typeAtSource##description##84401"
        },
        "xdm:mode": {
          "type": "string",
          "enum": ["push", "pull", "bidirectional"],
          "description": "How experiences are delivered in this channel.",
          "meta:enum": {
            "push": "The publisher of an experience can initiate an experience by sending a message into the channel. Most `push` channels involve some form of subscription or opt-in.",
            "pull": "The consumer can initiate an experience by requesting a location in the channel. Most `pull` channels give publishers some control how the experience is then delivered.",
            "bidirectional": "Both `push` and `pull` interaction modes are supported by the channel."
          },
          "meta:descriptionId": "channel##xdm:mode##description##40711",
          "meta:enumId": {
            "push": "channel##xdm:mode##meta:enum##push##44381",
            "pull": "channel##xdm:mode##meta:enum##pull##43921",
            "bidirectional": "channel##xdm:mode##meta:enum##bidirectional##74821"
          }
        },
        "@type": {
          "type": "string",
          "format": "uri",
          "description": "The `@type` property is used to provide a rough classification of channels with similar properties.",
          "meta:enum": {
            "https://ns.adobe.com/xdm/channel-types/web": "The world wide web, including mobile web",
            "https://ns.adobe.com/xdm/channel-types/social": "Social media platforms",
            "https://ns.adobe.com/xdm/channel-types/mobile": "Mobile apps",
            "https://ns.adobe.com/xdm/channel-types/messaging": "Instant messaging",
            "https://ns.adobe.com/xdm/channel-types/email": "Email",
            "https://ns.adobe.com/xdm/channel-types/offline": "Non-digital experience channels",
            "https://ns.adobe.com/xdm/channel-types/display": "Display",
            "https://ns.adobe.com/xdm/channel-types/search": "Search",
            "https://ns.adobe.com/xdm/channel-types/social_display": "Social Display",
            "https://ns.adobe.com/xdm/channel-types/video": "Video",
            "https://ns.adobe.com/xdm/channel-types/affiliate": "Affiliate",
            "https://ns.adobe.com/xdm/channel-types/affinity": "Affinity",
            "https://ns.adobe.com/xdm/channel-types/apps": "Applications",
            "https://ns.adobe.com/xdm/channel-types/preload": "Preload",
            "https://ns.adobe.com/xdm/channel-types/direct": "Direct",
            "https://ns.adobe.com/xdm/channel-types/external": "External",
            "https://ns.adobe.com/xdm/channel-types/mail": "Mail",
            "https://ns.adobe.com/xdm/channel-types/instore": "Instore"
          },
          "meta:descriptionId": "channel##@type##description##71341",
          "meta:enumId": {
            "https://ns.adobe.com/xdm/channel-types/web": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/web##941",
            "https://ns.adobe.com/xdm/channel-types/social": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/social##24901",
            "https://ns.adobe.com/xdm/channel-types/mobile": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/mobile##3241",
            "https://ns.adobe.com/xdm/channel-types/messaging": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/messaging##65341",
            "https://ns.adobe.com/xdm/channel-types/email": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/email##77181",
            "https://ns.adobe.com/xdm/channel-types/offline": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/offline##13801",
            "https://ns.adobe.com/xdm/channel-types/display": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/display##74661",
            "https://ns.adobe.com/xdm/channel-types/search": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/search##4901",
            "https://ns.adobe.com/xdm/channel-types/social_display": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/social_display##92931",
            "https://ns.adobe.com/xdm/channel-types/video": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/video##94551",
            "https://ns.adobe.com/xdm/channel-types/affiliate": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/affiliate##55971",
            "https://ns.adobe.com/xdm/channel-types/affinity": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/affinity##28391",
            "https://ns.adobe.com/xdm/channel-types/apps": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/apps##75471",
            "https://ns.adobe.com/xdm/channel-types/preload": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/preload##34291",
            "https://ns.adobe.com/xdm/channel-types/direct": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/direct##14321",
            "https://ns.adobe.com/xdm/channel-types/external": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/external##12971",
            "https://ns.adobe.com/xdm/channel-types/mail": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/mail##94151",
            "https://ns.adobe.com/xdm/channel-types/instore": "channel##@type##meta:enum##https://ns.adobe.com/xdm/channel-types/instore##14201"
          }
        },
        "xdm:mediaType": {
          "type": "string",
          "description": "Describes whether the media type is paid,owned or earned.",
          "meta:enum": {
            "paid": "Paid",
            "owned": "Owned",
            "earned": "Earned"
          },
          "meta:descriptionId": "channel##xdm:mediaType##description##84831",
          "meta:enumId": {
            "paid": "channel##xdm:mediaType##meta:enum##paid##33461",
            "owned": "channel##xdm:mediaType##meta:enum##owned##16761",
            "earned": "channel##xdm:mediaType##meta:enum##earned##55951"
          }
        },
        "xdm:mediaAction": {
          "type": "string",
          "description": "The `mediaAction` property is used to provide a type of experiance event media action .",
          "meta:enum": {
            "opens": "Opens",
            "sends": "Sends",
            "clicks": "Clicks",
            "impressions": "Impressions",
            "bounces": "Bounces",
            "mirrorpages": "Mirrorpages",
            "nonDeliverables": "NonDeliverables",
            "notSent": "NotSent",
            "offerOpens": "OfferOpens",
            "unSubscriptions": "UnSubscriptions",
            "userComplaints": "UserComplaints",
            "subscriptions": "Subscriptions"
          },
          "meta:descriptionId": "channel##xdm:mediaAction##description##43291",
          "meta:enumId": {
            "opens": "channel##xdm:mediaAction##meta:enum##opens##7651",
            "sends": "channel##xdm:mediaAction##meta:enum##sends##13681",
            "clicks": "channel##xdm:mediaAction##meta:enum##clicks##9871",
            "impressions": "channel##xdm:mediaAction##meta:enum##impressions##33861",
            "bounces": "channel##xdm:mediaAction##meta:enum##bounces##70321",
            "mirrorpages": "channel##xdm:mediaAction##meta:enum##mirrorpages##6361",
            "nonDeliverables": "channel##xdm:mediaAction##meta:enum##nonDeliverables##74011",
            "notSent": "channel##xdm:mediaAction##meta:enum##notSent##16791",
            "offerOpens": "channel##xdm:mediaAction##meta:enum##offerOpens##10561",
            "unSubscriptions": "channel##xdm:mediaAction##meta:enum##unSubscriptions##98991",
            "userComplaints": "channel##xdm:mediaAction##meta:enum##userComplaints##55441",
            "subscriptions": "channel##xdm:mediaAction##meta:enum##subscriptions##45111"
          }
        },
        "xdm:contentTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "description": "The `@type` of an XDM-defined content type that is supported by this channel.",
            "meta:descriptionId": "channel##items##description##96921"
          },
          "description": "The content types that this channel can deliver.",
          "meta:descriptionId": "channel##xdm:contentTypes##description##23231"
        },
        "xdm:metricTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "description": "The `@type` of an XDM-defined metric that is supported by this channel.",
            "meta:descriptionId": "channel##items##description##33061"
          },
          "description": "The metrics that can be collected in this channel.",
          "meta:descriptionId": "channel##xdm:metricTypes##description##81561"
        },
        "xdm:locationTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "description": "The `@type` of an XDM-defined location (virtual place) that this channel can contain.",
            "meta:descriptionId": "channel##items##description##42011"
          },
          "description": "The types of locations (virtual places) that this channel consists of and can deliver content to.",
          "meta:descriptionId": "channel##xdm:locationTypes##description##91781"
        },
        "xdm:referringSource": {
          "title": "Referring Source",
          "description": "Referring source to this channel",
          "type": "string",
          "meta:titleId": "channel##xdm:referringSource##title##94871",
          "meta:descriptionId": "channel##xdm:referringSource##description##88871"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://ns.adobe.com/xdm/common/extensible#/definitions/@context"
    },
    {
      "$ref": "#/definitions/channel"
    }
  ],
  "required": ["@id"],
  "meta:status": "stable",
