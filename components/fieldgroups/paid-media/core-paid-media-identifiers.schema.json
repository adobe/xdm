            "xdm:adNetwork": {
              "type": "string",
              "title": "Ad Network",
              "description": "The advertising platform/network",
              "enum": [
                "meta",
                "google_ads",
                "google_cm360",
                "snapchat",
                "pinterest",
                "tiktok",
                "linkedin",
                "amazon",
                "reddit",
                "twitter",
                "adobe_dsp",
                "other"
              ],
              "meta:enum": {
                "meta": "Meta Ads (Facebook/Instagram)",
                "google_ads": "Google Ads",
                "google_cm360": "Google Campaign Manager 360",
                "snapchat": "Snapchat Ads",
                "pinterest": "Pinterest Ads",
                "tiktok": "TikTok Ads",
                "linkedin": "LinkedIn Ads",
                "amazon": "Amazon Ads",
                "reddit": "Reddit Ads",
                "twitter": "Twitter/X Ads",
                "adobe_dsp": "Adobe DSP",
