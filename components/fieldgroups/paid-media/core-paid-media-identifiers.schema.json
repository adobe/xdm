                "linkedin": "core-identifiers##xdm:adNetwork##meta:enum##linkedin##89681",
                "amazon": "core-identifiers##xdm:adNetwork##meta:enum##amazon##95111",
                "reddit": "core-identifiers##xdm:adNetwork##meta:enum##reddit##74491",
                "twitter": "core-identifiers##xdm:adNetwork##meta:enum##twitter##48271",
                "adobe_dsp": "core-identifiers##xdm:adNetwork##meta:enum##adobe_dsp##86721",
                "other": "core-identifiers##xdm:adNetwork##meta:enum##other##13691"
