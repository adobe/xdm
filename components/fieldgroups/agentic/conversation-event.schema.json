  "$id": "https://ns.adobe.com/xdm/fieldgroups/agentic/conversationevent",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Conversation Event",
  "type": "object",
  "meta:extensible": true,
  "meta:tags": {
    "industry": ["all"]
  },
  "meta:intendedToExtend": ["https://ns.adobe.com/xdm/context/experienceevent"],
  "description": "Conversation Event data including agentic information, prompt, response, feedback an associated metadata.",
  "definitions": {
    "conversation": {
      "properties": {
        "xdm:eventType": {
          "title": "Event Type",
          "type": "string",
          "description": "The primary event type for this time-series record.",
          "meta:enum": {
            "conversation.turn": "Conversation Turn",
            "conversation.recommendation": "Conversation Recommendation",
            "conversation.feedback": "Conversation Feedback"
          },
          "meta:titleId": "conversationevent##xdm:eventType##title##27491",
          "meta:descriptionId": "conversationevent##xdm:eventType##description##93781",
          "meta:enumId": {
            "conversation.turn": "conversationevent##xdm:eventType##meta:enum##conversation.turn##95941",
            "conversation.recommendation": "conversationevent##xdm:eventType##meta:enum##conversation.recommendation##61081",
            "conversation.feedback": "conversationevent##xdm:eventType##meta:enum##conversation.feedback##53211"
          }
        },
        "xdm:conversation": {
          "title": "Conversation",
          "type": "object",
          "description": "Object representing a conversation that includes prompt, response, and feedback with associated metadata",
          "properties": {
            "xdm:conversationID": {
              "title": "Conversation ID",
              "type": "string",
              "description": "ID to group several turns together",
              "meta:titleId": "conversationevent##xdm:conversationID##title##76381",
              "meta:descriptionId": "conversationevent##xdm:conversationID##description##20371"
            },
            "xdm:conversationName": {
              "title": "Conversation Name",
              "type": "string",
              "description": "Name given to a conversation representing it's overall context",
              "meta:titleId": "conversationevent##xdm:conversationName##title##13881",
              "meta:descriptionId": "conversationevent##xdm:conversationName##description##90341"
            },
            "xdm:turnID": {
              "title": "Turn ID",
              "type": "string",
              "description": "A single instance of a prompt, response, and feedback",
              "meta:titleId": "conversationevent##xdm:turnID##title##56421",
              "meta:descriptionId": "conversationevent##xdm:turnID##description##12041"
            },
            "xdm:signals": {
              "type": "array",
              "title": "Conversation Signals",
              "description": "Signals based on this event and the conversation to date",
              "items": {
                "type": "object",
                "properties": {
                  "xdm:scope": {
                    "title": "Scope",
                    "description": "Scope of inputs from which this set of signals is derived.",
                    "type": "string",
                    "examples": [
                      "turn",
                      "conversation-to-date",
                      "last-N-turns",
                      "feedback"
                    ],
                    "meta:titleId": "conversationevent##xdm:scope##title##54191",
                    "meta:descriptionId": "conversationevent##xdm:scope##description##59981"
                  },
                  "xdm:attributes": {
                    "title": "Attributes",
                    "type": "object",
                    "description": "(DEPRECATED — use xdm:attributesMap) The set of derived signals for this scope. Superseded by xdm:attributesMap, which models signals as an extensible map keyed by signal id.",
                    "meta:status": "deprecated",
                    "properties": {
                      "xdm:subjects": {
                        "type": "object",
                        "title": "Subjects",
                        "properties": {
                          "xdm:values": {
                            "title": "Subjects",
                            "type": "array",
                            "items": {
                              "type": "object",
                              "description": "Subjects and qualifiers of the scoped input, similar to keywords but more meaningful",
                              "properties": {
                                "xdm:phrase": {
                                  "type": "string",
                                  "title": "Phrase",
                                  "description": "A phrase or keyword extracted from the scoped input",
                                  "meta:titleId": "conversationevent##xdm:phrase##title##93861",
                                  "meta:descriptionId": "conversationevent##xdm:phrase##description##90151"
                                },
                                "xdm:qualifiers": {
                                  "type": "array",
                                  "title": "Phrase Qualifiers",
                                  "items": {
                                    "type": "string",
                                    "title": "Phrase Qualifiers",
                                    "description": "List of qualifiers for the scoped input",
                                    "meta:titleId": "conversationevent##items##title##98291",
                                    "meta:descriptionId": "conversationevent##items##description##88021"
                                  },
                                  "meta:titleId": "conversationevent##xdm:qualifiers##title##48201"
                                }
                              },
                              "meta:descriptionId": "conversationevent##items##description##89341"
                            },
                            "meta:titleId": "conversationevent##xdm:values##title##22761"
                          }
                        },
                        "meta:titleId": "conversationevent##xdm:subjects##title##30261"
                      },
                      "xdm:intents": {
                        "type": "object",
                        "title": "Intents",
                        "properties": {
                          "xdm:values": {
                            "type": "array",
                            "title": "Intent Values",
                            "items": {
                              "title": "Intent Values",
                              "description": "Intents derived from the scoped input",
                              "type": "string",
                              "examples": [
                                "make a purchase",
                                "learn more",
                                "browsing"
                              ],
                              "meta:titleId": "conversationevent##items##title##89101",
                              "meta:descriptionId": "conversationevent##items##description##29321"
                            },
                            "meta:titleId": "conversationevent##xdm:values##title##88711"
                          }
                        },
                        "meta:titleId": "conversationevent##xdm:intents##title##41021"
                      },
                      "xdm:tones": {
                        "type": "object",
                        "title": "Tones",
                        "properties": {
                          "xdm:values": {
                            "type": "array",
                            "title": "Tone Values",
                            "items": {
                              "title": "Tone Values",
                              "description": "Tones derived from the scoped input",
                              "type": "string",
                              "examples": [
                                "thrilled",
                                "contemplative",
                                "upset"
                              ],
                              "meta:titleId": "conversationevent##items##title##85501",
                              "meta:descriptionId": "conversationevent##items##description##33431"
                            },
                            "meta:titleId": "conversationevent##xdm:values##title##30831"
                          }
                        },
                        "meta:titleId": "conversationevent##xdm:tones##title##33221"
                      },
                      "xdm:sentiment": {
                        "type": "object",
                        "title": "Sentiment",
                        "properties": {
                          "xdm:value": {
                            "title": "Sentiment Value",
                            "type": "number",
                            "description": "Score from -1 (meaning negative) to 1 (indicating positive) to indicate sentiment",
                            "minimum": -1,
                            "maximum": 1,
                            "examples": [-1, -0.34, 0, 0.7, 1],
                            "meta:titleId": "conversationevent##xdm:value##title##67681",
                            "meta:descriptionId": "conversationevent##xdm:value##description##19501"
                          }
                        },
                        "meta:titleId": "conversationevent##xdm:sentiment##title##23891"
                      }
                    },
                    "meta:titleId": "conversationevent##xdm:attributes##title##29341",
                    "meta:descriptionId": "conversationevent##xdm:attributes##description##55621"
                  },
                  "xdm:attributesMap": {
                    "title": "Signal Attributes Map",
                    "type": "object",
                    "description": "Map of signal id to signal value. The key is the signal identifier (for example 'subjects', 'intents', 'tones', 'sentiment', or any producer-defined signal). Supersedes xdm:attributes; new signal types require no schema change.",
                    "meta:xdmType": "map",
                    "meta:status": "experimental",
                    "additionalProperties": {
                      "type": "object",
                      "title": "Conversation Signal",
                      "description": "A single derived conversation signal. The xdm:type discriminator indicates which typed value field (xdm:stringValue, xdm:numberValue, or xdm:booleanValue) is populated on each entry of xdm:values.",
                      "properties": {
                        "xdm:type": {
                          "title": "Signal Value Type",
                          "type": "string",
                          "description": "Data type of this signal's values; tells consumers which typed value field is populated on each entry of xdm:values.",
                          "enum": ["string", "number", "boolean"],
                          "meta:enum": {
                            "string": "Values carry xdm:stringValue (e.g. an intent, tone, or extracted phrase)",
                            "number": "Values carry xdm:numberValue (e.g. a sentiment score or intensity)",
                            "boolean": "Values carry xdm:booleanValue (a true/false flag)"
                          },
                          "meta:titleId": "conversationevent##xdm:type##title##53611",
                          "meta:descriptionId": "conversationevent##xdm:type##description##97941",
                          "meta:enumId": {
                            "string": "conversationevent##xdm:type##meta:enum##string##9841",
                            "number": "conversationevent##xdm:type##meta:enum##number##66891",
                            "boolean": "conversationevent##xdm:type##meta:enum##boolean##23331"
                          }
                        },
                        "xdm:values": {
                          "title": "Signal Values",
                          "type": "array",
                          "description": "One or more values for this signal.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "xdm:stringValue": {
                                "title": "String Value",
                                "type": "string",
                                "description": "Populated when xdm:type is 'string'. A categorical value such as an intent, tone, or extracted phrase.",
                                "meta:titleId": "conversationevent##xdm:stringValue##title##46191",
                                "meta:descriptionId": "conversationevent##xdm:stringValue##description##35671"
                              },
                              "xdm:numberValue": {
                                "title": "Number Value",
                                "type": "number",
                                "description": "Populated when xdm:type is 'number'. For example a sentiment score from -1 to 1, or an intensity.",
                                "meta:titleId": "conversationevent##xdm:numberValue##title##75281",
                                "meta:descriptionId": "conversationevent##xdm:numberValue##description##8941"
                              },
                              "xdm:booleanValue": {
                                "title": "Boolean Value",
                                "type": "boolean",
                                "description": "Populated when xdm:type is 'boolean'. A true or false flag.",
                                "meta:titleId": "conversationevent##xdm:booleanValue##title##49171",
                                "meta:descriptionId": "conversationevent##xdm:booleanValue##description##58511"
                              },
                              "xdm:confidence": {
                                "title": "Confidence",
                                "type": "number",
                                "description": "Confidence the producer assigns to this value, from 0 to 1.",
                                "minimum": 0,
                                "maximum": 1,
                                "meta:titleId": "conversationevent##xdm:confidence##title##91741",
                                "meta:descriptionId": "conversationevent##xdm:confidence##description##64001"
                              },
                              "xdm:qualifiers": {
                                "title": "Qualifiers",
                                "type": "array",
                                "description": "Additional descriptors for this value, similar to keywords but more meaningful.",
                                "items": {
                                  "type": "string"
                                },
                                "meta:titleId": "conversationevent##xdm:qualifiers##title##88321",
                                "meta:descriptionId": "conversationevent##xdm:qualifiers##description##69261"
                              },
                              "xdm:metadata": {
                                "title": "Metadata",
                                "type": "array",
                                "description": "Producer-defined metadata for this value as key/value pairs (for example the context around a signal value). Modeled as an array of key/value pairs rather than a nested map so the enclosing xdm:attributesMap stays within the single-level map-depth limit.",
                                "items": {
                                  "$ref": "https://ns.adobe.com/xdm/datatypes/keyvalue"
                                },
                                "meta:titleId": "conversationevent##xdm:metadata##title##90491",
                                "meta:descriptionId": "conversationevent##xdm:metadata##description##94571"
                              }
                            }
                          },
                          "meta:titleId": "conversationevent##xdm:values##title##66051",
                          "meta:descriptionId": "conversationevent##xdm:values##description##18731"
                        }
                      },
                      "meta:titleId": "conversationevent##additionalProperties##title##30931",
                      "meta:descriptionId": "conversationevent##additionalProperties##description##79761"
                    },
                    "meta:titleId": "conversationevent##xdm:attributesMap##title##40251",
                    "meta:descriptionId": "conversationevent##xdm:attributesMap##description##28881"
                  }
                }
              },
              "meta:titleId": "conversationevent##xdm:signals##title##94731",
              "meta:descriptionId": "conversationevent##xdm:signals##description##79681"
            },
            "xdm:prompt": {
              "title": "Prompt",
              "type": "object",
              "description": "Object representing a conversation prompt",
              "properties": {
                "xdm:source": {
                  "title": "Prompt Source",
                  "type": "string",
                  "description": "Source of the prompt",
                  "examples": ["end-user", "bot", "canned"],
                  "meta:titleId": "conversationevent##xdm:source##title##88451",
                  "meta:descriptionId": "conversationevent##xdm:source##description##35351"
                },
                "xdm:raw": {
                  "type": "array",
                  "title": "Raw Text and Purpose",
                  "description": "Raw text with purpose of the text",
                  "items": {
                    "type": "object",
                    "properties": {
                      "xdm:text": {
                        "title": "Text",
                        "description": "Text",
                        "type": "string",
                        "meta:titleId": "conversationevent##xdm:text##title##5921",
                        "meta:descriptionId": "conversationevent##xdm:text##description##1941"
                      },
                      "xdm:purpose": {
                        "title": "Prompt Purpose",
                        "description": "Purpose of the prompt data. Users may input multiple things simultaneously such as text and a link or attachment.",
                        "type": "string",
                        "examples": ["free-form text", "attachment", "link"],
                        "meta:titleId": "conversationevent##xdm:purpose##title##88631",
                        "meta:descriptionId": "conversationevent##xdm:purpose##description##67261"
                      }
                    }
                  },
                  "meta:titleId": "conversationevent##xdm:raw##title##50551",
                  "meta:descriptionId": "conversationevent##xdm:raw##description##37691"
                }
              },
              "meta:titleId": "conversationevent##xdm:prompt##title##45471",
              "meta:descriptionId": "conversationevent##xdm:prompt##description##72211"
            },
            "xdm:response": {
              "title": "Response",
              "type": "object",
              "description": "Object representing a conversation response",
              "properties": {
                "xdm:source": {
                  "title": "Response Source",
                  "type": "string",
                  "description": "Source of the response",
                  "examples": ["end-user", "bot", "canned"],
                  "meta:titleId": "conversationevent##xdm:source##title##57571",
                  "meta:descriptionId": "conversationevent##xdm:source##description##7791"
                },
                "xdm:raw": {
                  "type": "array",
                  "title": "Raw Text and Purpose",
                  "description": "Raw text with purpose of the text",
                  "items": {
                    "type": "object",
                    "properties": {
                      "xdm:text": {
                        "title": "Text",
                        "description": "Text",
                        "type": "string",
                        "meta:titleId": "conversationevent##xdm:text##title##51071",
                        "meta:descriptionId": "conversationevent##xdm:text##description##21471"
                      },
                      "xdm:purpose": {
                        "title": "Response Purpose",
                        "description": "Purpose of the response data. Agents may respond with multiple things simultaneously such as text, video, links, pictures, etc.",
                        "type": "string",
                        "examples": ["main", "link", "picture", "video"],
                        "meta:titleId": "conversationevent##xdm:purpose##title##65231",
                        "meta:descriptionId": "conversationevent##xdm:purpose##description##95461"
                      }
                    }
                  },
                  "meta:titleId": "conversationevent##xdm:raw##title##56211",
                  "meta:descriptionId": "conversationevent##xdm:raw##description##20801"
                }
              },
              "meta:titleId": "conversationevent##xdm:response##title##76911",
              "meta:descriptionId": "conversationevent##xdm:response##description##73261"
            },
            "xdm:feedback": {
              "title": "Feedback",
              "type": "object",
              "description": "Object representing a conversation feedback",
              "properties": {
                "xdm:source": {
                  "title": "Feedback Source",
                  "type": "string",
                  "description": "Source of the feedback",
                  "examples": ["end-user", "bot", "canned"],
                  "meta:titleId": "conversationevent##xdm:source##title##64931",
                  "meta:descriptionId": "conversationevent##xdm:source##description##29521"
                },
                "xdm:raw": {
                  "type": "array",
                  "title": "Raw Text and Purpose",
                  "description": "Raw text with purpose of the text",
                  "items": {
                    "type": "object",
                    "properties": {
                      "xdm:text": {
                        "title": "Text",
                        "description": "Text",
                        "type": "string",
                        "meta:titleId": "conversationevent##xdm:text##title##63781",
                        "meta:descriptionId": "conversationevent##xdm:text##description##59441"
                      },
                      "xdm:purpose": {
                        "title": "Feedback Purpose",
                        "description": "Purpose of the feedback data. Users may input multiple things simultaneously such as text, screenshot, links, attachments, etc.",
                        "type": "string",
                        "examples": [
                          "free-form text",
                          "screenshot",
                          "attachment",
                          "link"
                        ],
                        "meta:titleId": "conversationevent##xdm:purpose##title##5551",
                        "meta:descriptionId": "conversationevent##xdm:purpose##description##23631"
                      }
                    }
                  },
                  "meta:titleId": "conversationevent##xdm:raw##title##50751",
                  "meta:descriptionId": "conversationevent##xdm:raw##description##83571"
                },
                "xdm:rating": {
                  "title": "Feedback Rating",
                  "type": "object",
                  "description": "Rating data for the feedback",
                  "properties": {
                    "xdm:score": {
                      "title": "Feedback Rating Score",
                      "type": "number",
                      "description": "Numerical value of the rating provided by the end-user ranging from -1.0 (negative) to 1.0 (positive).",
                      "meta:titleId": "conversationevent##xdm:score##title##94601",
                      "meta:descriptionId": "conversationevent##xdm:score##description##65371"
                    },
                    "xdm:classification": {
                      "title": "Feedback Rating Classification",
                      "type": "string",
                      "description": "String/enum value of the rating provided by the end-user.",
                      "examples": [
                        "Thumbs Up",
                        "Thumbs Down",
                        "Positive",
                        "Negative",
                        "5-stars",
                        "1-star"
                      ],
                      "meta:titleId": "conversationevent##xdm:classification##title##22401",
                      "meta:descriptionId": "conversationevent##xdm:classification##description##70201"
                    },
                    "xdm:reasons": {
                      "title": "Feedback Rating Reasons",
                      "type": "array",
                      "description": "Canned reasons why the customer provided this rating usually presented as a set of checkboxes.",
                      "items": {
                        "type": "string"
                      },
                      "meta:titleId": "conversationevent##xdm:reasons##title##69271",
                      "meta:descriptionId": "conversationevent##xdm:reasons##description##35451"
                    }
                  },
                  "meta:titleId": "conversationevent##xdm:rating##title##38681",
                  "meta:descriptionId": "conversationevent##xdm:rating##description##71681"
                }
              },
              "meta:titleId": "conversationevent##xdm:feedback##title##88191",
              "meta:descriptionId": "conversationevent##xdm:feedback##description##4931"
            }
          },
          "meta:titleId": "conversationevent##xdm:conversation##title##4981",
          "meta:descriptionId": "conversationevent##xdm:conversation##description##75591"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://ns.adobe.com/xdm/common/extensible#/definitions/@context"
    },
    {
      "$ref": "#/definitions/conversation"
    }
  ],
  "meta:status": "stable",
  "meta:titleId": "conversationevent##title##27011",
  "meta:descriptionId": "conversationevent##description##94171"
}
