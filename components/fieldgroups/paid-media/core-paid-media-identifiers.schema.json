                "meta": "core-identifiers##xdm:adNetwork##meta:enum##meta##61161",
                "google_ads": "core-identifiers##xdm:adNetwork##meta:enum##google_ads##17021",
                "google_cm360": "core-identifiers##xdm:adNetwork##meta:enum##google_cm360##10701",
