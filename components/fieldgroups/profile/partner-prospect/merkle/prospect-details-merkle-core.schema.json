                      "type": "integer",
                      "title": "MS080-Inferred Age",
                      "description": "Estimates the age of the individual using both individual and area level data. Present only when exact age is not present.",
                      "meta:titleId": "prospect-details-merkle-core##xdm:inferredAge##title##78721",
                      "meta:descriptionId": "prospect-details-merkle-core##xdm:inferredAge##description##46701"
