  },
  "allOf": [
    {
      "$ref": "#/definitions/core-identifiers"
    }
  ],
  "meta:status": "stable",
  "meta:titleId": "core-identifiers##title##9811",
  "meta:descriptionId": "core-identifiers##description##77711"
