              "title": "Ticket Sales End Time",
              "description": "",
              "type": "string",
              "format": "date-time",
              "meta:titleId": "sports-entertainment-event-schedule##xdm:ticketSalesEndTime##title##73451",
              "meta:descriptionId": "sports-entertainment-event-schedule##xdm:ticketSalesEndTime##description##41031"
