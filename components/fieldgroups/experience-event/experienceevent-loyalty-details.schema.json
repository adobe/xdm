  "$id": "https://ns.adobe.com/xdm/context/experienceevent-loyalty-details",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Loyalty Event Details",
  "type": "object",
  "meta:extensible": true,
  "meta:abstract": true,
  "meta:tags": {
    "industry": ["all"]
  },
  "meta:intendedToExtend": ["https://ns.adobe.com/xdm/context/experienceevent"],
  "description": "Loyalty-related event data such as discounts, coupon/points/redemption, referrals, and points gained.",
  "definitions": {
    "experienceevent-loyalty": {
      "properties": {
        "xdm:loyalty": {
          "type": "object",
          "description": "Captures loyalty-related attributes observed on an experience event.",
          "properties": {
            "xdm:discounts": {
              "title": "Discounts",
              "type": "array",
              "description": "List of discounts applied as part of this event.",
              "items": {
                "type": "object",
                "properties": {
                  "xdm:value": {
                    "title": "Discount Value",
                    "type": "number",
                    "description": "Monetary value of the discount applied.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:value##title##70191",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:value##description##75811"
                  },
                  "xdm:source": {
                    "title": "Discount Source",
                    "type": "string",
                    "description": "Origin of the discount (e.g., coupon, referral, pointsRedemption).",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:source##title##91071",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:source##description##30271"
                  },
                  "xdm:triggeredForItem": {
                    "title": "Triggered For Item",
                    "type": "string",
                    "description": "SKU or identifier of the item this discount is for, if applicable.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:triggeredForItem##title##641",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:triggeredForItem##description##13571"
                  },
                  "xdm:scope": {
                    "title": "Scope",
                    "type": "string",
                    "description": "Scope of the discount (e.g., additionalCost, item, total).",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:scope##title##801",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:scope##description##11631"
                  },
                  "xdm:promotionId": {
                    "title": "Promotion ID",
                    "type": "string",
                    "description": "Identifier of the promotion that triggered this discount.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:promotionId##title##11851",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:promotionId##description##63821"
                  }
                }
              },
              "meta:titleId": "experienceevent-loyalty-details##xdm:discounts##title##55251",
              "meta:descriptionId": "experienceevent-loyalty-details##xdm:discounts##description##42641"
            },
            "xdm:couponRedemption": {
              "title": "Coupon Redemptions",
              "type": "array",
              "description": "Coupons redeemed during this event.",
              "items": {
                "type": "object",
                "properties": {
                  "xdm:id": {
                    "title": "Coupon ID",
                    "type": "string",
                    "description": "Coupon code or identifier.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:id##title##99781",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:id##description##24081"
                  },
                  "xdm:series": {
                    "title": "Coupon Series",
                    "type": "string",
                    "description": "Series or campaign the coupon belongs to.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:series##title##82971",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:series##description##51871"
                  },
                  "xdm:seriesName": {
                    "title": "Coupon Series Name",
                    "type": "string",
                    "description": "Human-readable name of the coupon series.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:seriesName##title##21041",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:seriesName##description##83091"
                  },
                  "xdm:promotionId": {
                    "title": "Promotion ID",
                    "type": "string",
                    "description": "Identifier of the promotion this coupon is from.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:promotionId##title##31701",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:promotionId##description##92251"
                  }
                }
              },
              "meta:titleId": "experienceevent-loyalty-details##xdm:couponRedemption##title##69751",
              "meta:descriptionId": "experienceevent-loyalty-details##xdm:couponRedemption##description##88861"
            },
            "xdm:pointsRedemption": {
              "title": "Points Redemption",
              "type": "array",
              "description": "Points redeemed as part of this event.",
              "items": {
                "type": "object",
                "properties": {
                  "xdm:value": {
                    "title": "Points Value",
                    "type": "number",
                    "description": "Number of points redeemed.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:value##title##59291",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:value##description##79821"
                  },
                  "xdm:promotionId": {
                    "title": "Promotion ID",
                    "type": "string",
                    "description": "Identifier of the promotion governing this points redemption.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:promotionId##title##62681",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:promotionId##description##41831"
                  },
                  "xdm:loyaltyProgramId": {
                    "title": "Loyalty Program ID",
                    "type": "string",
                    "description": "Identifier of the loyalty program managing these points.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:loyaltyProgramId##title##10941",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:loyaltyProgramId##description##64691"
                  },
                  "xdm:transactionId": {
                    "title": "Transaction ID",
                    "type": "string",
                    "description": "Identifier of the points redemption transaction, if applicable.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:transactionId##title##76771",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:transactionId##description##26771"
                  }
                }
              },
              "meta:titleId": "experienceevent-loyalty-details##xdm:pointsRedemption##title##10151",
              "meta:descriptionId": "experienceevent-loyalty-details##xdm:pointsRedemption##description##97571"
            },
            "xdm:referralRedemption": {
              "title": "Referral Redemptions",
              "type": "array",
              "description": "Referral codes redeemed during this event.",
              "items": {
                "type": "object",
                "properties": {
                  "xdm:code": {
                    "title": "Referral Code",
                    "type": "string",
                    "description": "Referral code used.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:code##title##13701",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:code##description##38171"
                  },
                  "xdm:promotionId": {
                    "title": "Promotion ID",
                    "type": "string",
                    "description": "Identifier of the promotion the referral is from.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:promotionId##title##65961",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:promotionId##description##48451"
                  }
                }
              },
              "meta:titleId": "experienceevent-loyalty-details##xdm:referralRedemption##title##781",
              "meta:descriptionId": "experienceevent-loyalty-details##xdm:referralRedemption##description##61171"
            },
            "xdm:pointsGained": {
              "title": "Points Gained",
              "type": "array",
              "description": "Points gained as part of this event.",
              "items": {
                "type": "object",
                "properties": {
                  "xdm:value": {
                    "title": "Points Value",
                    "type": "number",
                    "description": "Number of points gained.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:value##title##38581",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:value##description##88001"
                  },
                  "xdm:promotionId": {
                    "title": "Promotion ID",
                    "type": "string",
                    "description": "Identifier of the promotion governing this points acquisition.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:promotionId##title##35501",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:promotionId##description##20311"
                  },
                  "xdm:loyaltyProgramId": {
                    "title": "Loyalty Program ID",
                    "type": "string",
                    "description": "Identifier of the loyalty program managing these points.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:loyaltyProgramId##title##75241",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:loyaltyProgramId##description##1251"
                  },
                  "xdm:transactionId": {
                    "title": "Transaction ID",
                    "type": "string",
                    "description": "Identifier of the points acquisition transaction, if applicable.",
                    "meta:titleId": "experienceevent-loyalty-details##xdm:transactionId##title##4671",
                    "meta:descriptionId": "experienceevent-loyalty-details##xdm:transactionId##description##86011"
                  }
                }
              },
              "meta:titleId": "experienceevent-loyalty-details##xdm:pointsGained##title##34271",
              "meta:descriptionId": "experienceevent-loyalty-details##xdm:pointsGained##description##21421"
            }
          },
          "meta:descriptionId": "experienceevent-loyalty-details##xdm:loyalty##description##69611"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/experienceevent-loyalty"
    }
  ],
  "meta:status": "stable",
  "meta:titleId": "experienceevent-loyalty-details##title##28251",
  "meta:descriptionId": "experienceevent-loyalty-details##description##7331"
}
