  "$id": "https://ns.adobe.com/xdm/mixins/experienceevent-healthcare-sitetool",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Sitetool Details",
  "type": "object",
  "meta:extensible": true,
  "meta:abstract": true,
  "meta:tags": {
    "industry": [
      "healthcare_services"
    ]
  },
  "meta:intendedToExtend": [
    "https://ns.adobe.com/xdm/context/experienceevent"
  ],
  "description": "Generic collection of site tool behaviors for online interactions. For example interactions with chatbots, surveys, or questionnaires.",
  "definitions": {
    "sitetool-details": {
      "properties": {
        "xdm:sitetool": {
          "Title": "Site Tool",
          "description": "Information collected by sitetool.",
          "type": "object",
          "properties": {
            "xdm:name": {
              "Title": "Site Tool Name",
              "type": "string",
              "description": "Name of the site tool. I.e., chatbot, survey, questionnaire.",
              "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:name##description##24701"
            },
            "xdm:section": {
              "Title": "Site Tool Section",
              "type": "string",
              "description": "Section of the site tool. I.e., main, sub, etc.",
              "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:section##description##92741"
            },
            "xdm:actor": {
              "Title": "Actor",
              "type": "string",
              "description": "A person/member who did the action.",
              "meta:enum": {
                "Member": "Member",
                "Practitioner": "Practitioner",
                "RelatedPerson": "RelatedPerson"
              },
              "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:actor##description##50281",
              "meta:enumId": {
                "Member": "experienceevent-healthcare-sitetool##xdm:actor##meta:enum##Member##38661",
                "Practitioner": "experienceevent-healthcare-sitetool##xdm:actor##meta:enum##Practitioner##51661",
                "RelatedPerson": "experienceevent-healthcare-sitetool##xdm:actor##meta:enum##RelatedPerson##68361"
              }
            },
            "xdm:actorID": {
              "Title": "Actor ID",
              "type": "string",
              "description": "Reference to the actor who could be a member,practionner or a relatedperson.",
              "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:actorID##description##15071"
            },
            "xdm:dataGatheringEvent": {
              "Title": "Data Gathering Event",
              "type": "object",
              "description": "Indicates if this event is a data gathering event and the other event details.",
              "properties": {
                "xdm:isTrue": {
                  "Title": "Is True",
                  "type": "boolean",
                  "description": "Indicates if this event is a data gathering event like quiz,survey, poll.",
                  "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:isTrue##description##48481"
                },
                "xdm:data": {
                  "Title": "Data",
                  "type": "object",
                  "meta:xdmType": "map",
                  "description": "Data that is collected and submitted as part of quiz,survey or poll submit event.",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "xdm:question": {
                        "Title": "Question",
                        "type": "string",
                        "description": "Question of for which the response is collected.",
                        "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:question##description##14261"
                      },
                      "xdm:response": {
                        "Title": "Response",
                        "type": "string",
                        "description": "Response provided by the actor.",
                        "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:response##description##78371"
                      }
                    }
                  },
                  "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:data##description##78001"
                },
                "xdm:score": {
                  "Title": "Score",
                  "type": "integer",
                  "description": "Score secured by the actor based on event responses.",
                  "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:score##description##2781"
                }
              },
              "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:dataGatheringEvent##description##66901"
            },
            "xdm:isKeyEvent": {
              "Title": "Is Key Event",
              "type": "boolean",
              "description": "Indicates if this event is a key event.",
              "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:isKeyEvent##description##87601"
            }
          },
          "meta:descriptionId": "experienceevent-healthcare-sitetool##xdm:sitetool##description##3091"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/sitetool-details"
    }
  ],
