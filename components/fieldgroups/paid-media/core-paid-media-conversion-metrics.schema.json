                    "xdm:fraudRate": {
                      "type": "number",
                      "title": "Fraud Rate",
                      "description": "Percentage of conversions flagged as fraudulent",
                      "minimum": 0,
                      "maximum": 1,
                      "meta:titleId": "conversion-metrics##xdm:fraudRate##title##43931",
                      "meta:descriptionId": "conversion-metrics##xdm:fraudRate##description##22361"
                    },
                    "xdm:validationRate": {
                      "type": "number",
                      "title": "Validation Rate",
                      "description": "Percentage of conversions that passed validation",
                      "minimum": 0,
                      "maximum": 1,
                      "meta:titleId": "conversion-metrics##xdm:validationRate##title##75031",
                      "meta:descriptionId": "conversion-metrics##xdm:validationRate##description##35951"
                    }
                  },
                  "meta:titleId": "conversion-metrics##xdm:conversionQuality##title##69781",
                  "meta:descriptionId": "conversion-metrics##xdm:conversionQuality##description##53851"
