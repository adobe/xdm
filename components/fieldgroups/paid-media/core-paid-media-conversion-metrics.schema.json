  "allOf": [
    {
      "$ref": "#/definitions/conversion-metrics"
    }
  ],
  "meta:status": "stable",
  "meta:titleId": "conversion-metrics##title##63561",
  "meta:descriptionId": "conversion-metrics##description##99001"
}
