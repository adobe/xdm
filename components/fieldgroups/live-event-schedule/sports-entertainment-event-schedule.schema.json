              "meta:descriptionId": "sports-entertainment-event-schedule##xdm:regularDoorTime##description##82681"
            },
            "xdm:ticketSalesStartTime": {
              "title": "Ticket Sales Start Time",
              "description": "",
              "type": "string",
              "format": "date-time",
              "meta:titleId": "sports-entertainment-event-schedule##xdm:ticketSalesStartTime##title##85221",
              "meta:descriptionId": "sports-entertainment-event-schedule##xdm:ticketSalesStartTime##description##71741"
            },
