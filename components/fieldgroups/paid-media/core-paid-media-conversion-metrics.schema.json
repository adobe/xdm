                    "xdm:qualityScore": {
                      "type": "number",
                      "title": "Quality Score",
                      "description": "Overall conversion quality score",
                      "minimum": 0,
                      "maximum": 10,
                      "meta:titleId": "conversion-metrics##xdm:qualityScore##title##82641",
                      "meta:descriptionId": "conversion-metrics##xdm:qualityScore##description##72581"
