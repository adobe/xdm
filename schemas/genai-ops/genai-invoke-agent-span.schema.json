  "$id": "https://ns.adobe.com/xdm/mixins/genai-invoke-agent-span",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "GenAI Invoke Agent Span",
  "type": "object",
  "auditable": true,
  "meta:extensible": true,
  "meta:abstract": true,
  "meta:intendedToExtend": [
    "https://ns.adobe.com/xdm/classes/aep-ai-agent-trace"
  ],
  "description": "Captures properties related to GenAI Agent Execution Spans.",
  "definitions": {
    "genai-invoke-agent-span": {
      "properties": {
        "xdm:gen_ai": {
          "type": "object",
          "properties": {
            "xdm:operation": {
              "type": "object",
              "properties": {
                "xdm:name": {
                  "type": "string",
                  "description": "The name of the operation being performed.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:name##description##55801"
                }
              }
            },
            "xdm:provider": {
              "type": "object",
              "properties": {
                "xdm:name": {
                  "type": "string",
                  "description": "The Generative AI provider as identified by the client or server instrumentation.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:name##description##88691"
                }
              }
            },
            "xdm:system": {
              "type": "string",
              "description": "The Generative AI product as identified by the client or server instrumentation.",
              "meta:descriptionId": "genai-invoke-agent-span##xdm:system##description##5681"
            },
            "xdm:agent": {
              "type": "object",
              "properties": {
                "xdm:description": {
                  "type": "string",
                  "description": "Free-form description of the GenAI agent provided by the application.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:description##description##55931"
                },
                "xdm:id": {
                  "type": "string",
                  "description": "The unique identifier of the GenAI agent.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:id##description##24691"
                },
                "xdm:name": {
                  "type": "string",
                  "description": "Human-readable name of the GenAI agent provided by the application.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:name##description##34021"
                }
              }
            },
            "xdm:conversation": {
              "type": "object",
              "properties": {
                "xdm:id": {
                  "type": "string",
                  "description": "The unique identifier for a conversation (session, thread), used to store and correlate messages within this conversation.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:id##description##86251"
                }
              }
            },
            "xdm:data_source": {
              "type": "object",
              "properties": {
                "xdm:id": {
                  "type": "string",
                  "description": "The data source identifier.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:id##description##9681"
                }
              }
            },
            "xdm:input": {
              "type": "object",
              "properties": {
                "xdm:messages": {
                  "type": "string",
                  "description": "The chat history provided to the model as an input.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:messages##description##61451"
                }
              }
            },
            "xdm:output": {
              "type": "object",
              "properties": {
                "xdm:type": {
                  "type": "string",
                  "description": "Represents the content type requested by the client.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:type##description##48341"
                },
                "xdm:messages": {
                  "type": "string",
                  "description": "Messages returned by the model where each message represents a specific model response (choice, candidate)",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:messages##description##70631"
                }
              }
            },
            "xdm:request": {
              "type": "object",
              "properties": {
                "xdm:choice": {
                  "type": "object",
                  "properties": {
                    "xdm:count": {
                      "type": "integer",
                      "description": "The target number of candidate completions to return.",
                      "meta:descriptionId": "genai-invoke-agent-span##xdm:count##description##64131"
                    }
                  }
                },
                "xdm:model": {
                  "type": "string",
                  "description": "The name of the GenAI model a request is being made to.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:model##description##46981"
                },
                "xdm:seed": {
                  "type": "integer",
                  "description": "Requests with same seed value more likely to return same result.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:seed##description##7871"
                },
                "xdm:frequency_penalty": {
                  "type": "number",
                  "description": "The frequency penalty setting for the GenAI request.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:frequency_penalty##description##64971"
                },
                "xdm:max_tokens": {
                  "type": "integer",
                  "description": "The maximum number of tokens the model generates for a request.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:max_tokens##description##21651"
                },
                "xdm:presence_penalty": {
                  "type": "number",
                  "description": "The presence penalty setting for the GenAI request.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:presence_penalty##description##32091"
                },
                "xdm:stop_sequences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of sequences that the model will use to stop generating further tokens.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:stop_sequences##description##96571"
                },
                "xdm:temperature": {
                  "type": "number",
                  "description": "The temperature setting for the GenAI request.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:temperature##description##77301"
                },
                "xdm:top_p": {
                  "type": "number",
                  "description": "The top_p sampling setting for the GenAI request.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:top_p##description##38271"
                }
              }
            },
            "xdm:response": {
              "type": "object",
              "properties": {
                "xdm:finish_reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Array of reasons the model stopped generating tokens, corresponding to each generation received.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:finish_reasons##description##36121"
                },
                "xdm:id": {
                  "type": "string",
                  "description": "The unique identifier for the completion.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:id##description##72721"
                },
                "xdm:model": {
                  "type": "string",
                  "description": "The name of the model that generated the response.",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:model##description##95071"
                }
              }
            },
            "xdm:usage": {
              "type": "object",
              "properties": {
                "xdm:input_tokens": {
                  "type": "integer",
                  "description": "The number of tokens used in the GenAI input (prompt).",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:input_tokens##description##76111"
                },
                "xdm:output_tokens": {
                  "type": "integer",
                  "description": "The number of tokens used in the GenAI response (completion).",
                  "meta:descriptionId": "genai-invoke-agent-span##xdm:output_tokens##description##48291"
                }
              }
            },
            "xdm:system_instructions": {
              "type": "string",
              "description": "The system message or instructions provided to the GenAI model separately from the chat history.",
              "meta:descriptionId": "genai-invoke-agent-span##xdm:system_instructions##description##62801"
            }
          }
        },
        "xdm:error": {
          "type": "object",
          "properties": {
            "xdm:type": {
              "type": "string",
              "description": "Describes a class of error the operation ended with.",
              "meta:descriptionId": "genai-invoke-agent-span##xdm:type##description##9251"
            }
          }
        },
        "xdm:server": {
          "type": "object",
          "properties": {
            "xdm:port": {
              "type": "integer",
              "description": "GenAI server port.",
              "meta:descriptionId": "genai-invoke-agent-span##xdm:port##description##12511"
            },
            "xdm:address": {
              "type": "string",
              "description": "GenAI server address.",
              "meta:descriptionId": "genai-invoke-agent-span##xdm:address##description##42541"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/genai-invoke-agent-span"
    }
  ],
  "meta:status": "experimental",
  "meta:titleId": "genai-invoke-agent-span##title##46701",
  "meta:descriptionId": "genai-invoke-agent-span##description##2241"
}
