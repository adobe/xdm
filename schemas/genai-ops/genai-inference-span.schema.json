  "$id": "https://ns.adobe.com/xdm/mixins/genai-inference-span",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "GenAI Inference Span",
  "type": "object",
  "auditable": true,
  "meta:extensible": true,
  "meta:abstract": true,
  "meta:intendedToExtend": [
    "https://ns.adobe.com/xdm/classes/aep-ai-agent-trace"
  ],
  "description": "Captures properties related to GenAI Inference Spans.",
  "definitions": {
    "genai-inference-span": {
      "properties": {
        "xdm:gen_ai": {
          "type": "object",
          "properties": {
            "xdm:operation": {
              "type": "object",
              "properties": {
                "xdm:name": {
                  "type": "string",
                  "description": "The name of the operation being performed.",
                  "meta:descriptionId": "genai-inference-span##xdm:name##description##34891"
                }
              }
            },
            "xdm:system": {
              "type": "string",
              "description": "The Generative AI product as identified by the client or server instrumentation.",
              "meta:descriptionId": "genai-inference-span##xdm:system##description##38911"
            },
            "xdm:system_instructions": {
              "type": "string",
              "description": "The system message or instructions provided to the GenAI model separately from the chat history..",
              "meta:descriptionId": "genai-inference-span##xdm:system_instructions##description##14311"
            },
            "xdm:conversation": {
              "type": "object",
              "properties": {
                "xdm:id": {
                  "type": "string",
                  "description": "The unique identifier for a conversation (session, thread), used to store and correlate messages within this conversation.",
                  "meta:descriptionId": "genai-inference-span##xdm:id##description##46511"
                }
              }
            },
            "xdm:input": {
              "type": "object",
              "properties": {
                "xdm:messages": {
                  "type": "string",
                  "description": "The chat history provided to the model as an input.",
                  "meta:descriptionId": "genai-inference-span##xdm:messages##description##77491"
                }
              }
            },
            "xdm:output": {
              "type": "object",
              "properties": {
                "xdm:type": {
                  "type": "string",
                  "description": "Represents the content type requested by the client.",
                  "meta:descriptionId": "genai-inference-span##xdm:type##description##56811"
                },
                "xdm:messages": {
                  "type": "string",
                  "description": "Messages returned by the model where each message represents a specific model response (choice, candidate)",
                  "meta:descriptionId": "genai-inference-span##xdm:messages##description##12261"
                }
              }
            },
            "xdm:request": {
              "type": "object",
              "properties": {
                "xdm:choice": {
                  "type": "object",
                  "properties": {
                    "xdm:count": {
                      "type": "integer",
                      "description": "The target number of candidate completions to return.",
                      "meta:descriptionId": "genai-inference-span##xdm:count##description##67321"
                    }
                  }
                },
                "xdm:model": {
                  "type": "string",
                  "description": "The name of the GenAI model a request is being made to.",
                  "meta:descriptionId": "genai-inference-span##xdm:model##description##82921"
                },
                "xdm:seed": {
                  "type": "integer",
                  "description": "Requests with same seed value more likely to return same result.",
                  "meta:descriptionId": "genai-inference-span##xdm:seed##description##98791"
                },
                "xdm:frequency_penalty": {
                  "type": "number",
                  "description": "The frequency penalty setting for the GenAI request.",
                  "meta:descriptionId": "genai-inference-span##xdm:frequency_penalty##description##5401"
                },
                "xdm:max_tokens": {
                  "type": "integer",
                  "description": "The maximum number of tokens the model generates for a request.",
                  "meta:descriptionId": "genai-inference-span##xdm:max_tokens##description##38671"
                },
                "xdm:presence_penalty": {
                  "type": "number",
                  "description": "The presence penalty setting for the GenAI request.",
                  "meta:descriptionId": "genai-inference-span##xdm:presence_penalty##description##71431"
                },
                "xdm:stop_sequences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of sequences that the model will use to stop generating further tokens.",
                  "meta:descriptionId": "genai-inference-span##xdm:stop_sequences##description##46951"
                },
                "xdm:temperature": {
                  "type": "number",
                  "description": "The temperature setting for the GenAI request.",
                  "meta:descriptionId": "genai-inference-span##xdm:temperature##description##54971"
                },
                "xdm:top_k": {
                  "type": "number",
                  "description": "The top_k sampling setting for the GenAI request.",
                  "meta:descriptionId": "genai-inference-span##xdm:top_k##description##14961"
                },
                "xdm:top_p": {
                  "type": "number",
                  "description": "The top_p sampling setting for the GenAI request.",
                  "meta:descriptionId": "genai-inference-span##xdm:top_p##description##9711"
                }
              }
            },
            "xdm:response": {
              "type": "object",
              "properties": {
                "xdm:finish_reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Array of reasons the model stopped generating tokens, corresponding to each generation received.",
                  "meta:descriptionId": "genai-inference-span##xdm:finish_reasons##description##11331"
                },
                "xdm:id": {
                  "type": "string",
                  "description": "The unique identifier for the completion.",
                  "meta:descriptionId": "genai-inference-span##xdm:id##description##41291"
                },
                "xdm:model": {
                  "type": "string",
                  "description": "The name of the model that generated the response.",
                  "meta:descriptionId": "genai-inference-span##xdm:model##description##63671"
                }
              }
            },
            "xdm:usage": {
              "type": "object",
              "properties": {
                "xdm:input_tokens": {
                  "type": "integer",
                  "description": "The number of tokens used in the GenAI input (prompt).",
                  "meta:descriptionId": "genai-inference-span##xdm:input_tokens##description##97801"
                },
                "xdm:output_tokens": {
                  "type": "integer",
                  "description": "The number of tokens used in the GenAI response (completion).",
                  "meta:descriptionId": "genai-inference-span##xdm:output_tokens##description##42601"
                }
              }
            }
          }
        },
        "xdm:error": {
          "type": "object",
          "properties": {
            "xdm:type": {
              "type": "string",
              "description": "Describes a class of error the operation ended with.",
              "meta:descriptionId": "genai-inference-span##xdm:type##description##21141"
            }
          }
        },
        "xdm:server": {
          "type": "object",
          "properties": {
            "xdm:address": {
              "type": "string",
              "description": "GenAI server address.",
              "meta:descriptionId": "genai-inference-span##xdm:address##description##33151"
            },
            "xdm:port": {
              "type": "integer",
              "description": "GenAI server port.",
              "meta:descriptionId": "genai-inference-span##xdm:port##description##8481"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/genai-inference-span"
    }
  ],
  "meta:status": "experimental",
  "meta:titleId": "genai-inference-span##title##64831",
  "meta:descriptionId": "genai-inference-span##description##77161"
}
