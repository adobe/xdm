                      "type": "number",
                      "title": "Average Touchpoints",
                      "minimum": 0,
                      "meta:titleId": "conversion-metrics##xdm:averageTouchpoints##title##40041"
                    },
                    "xdm:assistedConversions": {
                      "type": "number",
                      "title": "Assisted Conversions",
                      "minimum": 0,
                      "meta:titleId": "conversion-metrics##xdm:assistedConversions##title##1961"
                    },
                    "xdm:directConversions": {
                      "type": "number",
                      "title": "Direct Conversions",
                      "minimum": 0,
                      "meta:titleId": "conversion-metrics##xdm:directConversions##title##64151"
