          "additionalProperties": {
            "title": "consent policy id map",
            "description": "map of validated fields for a consent policy",
            "type": "object",
            "properties": {
              "xdm:status": {
                "title": "string",
                "description": "current status for a given consent policy",
                "type": "string",
                "enum": ["realized", "exited"],
                "meta:enum": {
                  "realized": "Realized",
                  "exited": "Exited"
                },
                "meta:titleId": "profile-consentResults-v2##xdm:status##title##7761",
                "meta:descriptionId": "profile-consentResults-v2##xdm:status##description##33801",
