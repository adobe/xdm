  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "https://ns.adobe.com/xdm/mixins/paid-media/core-identifiers",
  "title": "Core Paid Media Identifiers",
  "type": "object",
  "meta:extensible": true,
  "meta:abstract": true,
  "meta:intendedToExtend": [
    "https://ns.adobe.com/xdm/classes/paid-media",
    "https://ns.adobe.com/xdm/classes/summarymetrics"
  ],
  "description": "Core identifier fields used across all paid media entities and ad networks",
  "definitions": {
    "core-identifiers": {
      "properties": {
        "xdm:paidMedia": {
          "type": "object",
          "properties": {
            "xdm:adNetwork": {
              "type": "string",
              "title": "Ad Network",
              "description": "The advertising platform/network",
              "enum": [
                "meta",
                "google_ads",
                "google_cm360",
                "snapchat",
                "pinterest",
                "tiktok",
                "linkedin",
                "amazon",
                "reddit",
                "twitter",
                "adobe_dsp",
                "other"
              ],
              "meta:enum": {
                "meta": "Meta Ads (Facebook/Instagram)",
                "google_ads": "Google Ads",
                "google_cm360": "Google Campaign Manager 360",
                "snapchat": "Snapchat Ads",
                "pinterest": "Pinterest Ads",
                "tiktok": "TikTok Ads",
                "linkedin": "LinkedIn Ads",
                "amazon": "Amazon Ads",
                "reddit": "Reddit Ads",
                "twitter": "Twitter/X Ads",
                "adobe_dsp": "Adobe DSP",
                "other": "Other ad network"
              },
              "meta:titleId": "core-identifiers##xdm:adNetwork##title##12081",
              "meta:descriptionId": "core-identifiers##xdm:adNetwork##description##98771",
              "meta:enumId": {
                "meta": "core-identifiers##xdm:adNetwork##meta:enum##meta##32411",
                "google_ads": "core-identifiers##xdm:adNetwork##meta:enum##google_ads##14481",
                "google_cm360": "core-identifiers##xdm:adNetwork##meta:enum##google_cm360##29771",
                "snapchat": "core-identifiers##xdm:adNetwork##meta:enum##snapchat##61201",
                "pinterest": "core-identifiers##xdm:adNetwork##meta:enum##pinterest##15021",
                "tiktok": "core-identifiers##xdm:adNetwork##meta:enum##tiktok##46121",
                "linkedin": "core-identifiers##xdm:adNetwork##meta:enum##linkedin##15281",
                "amazon": "core-identifiers##xdm:adNetwork##meta:enum##amazon##80961",
                "reddit": "core-identifiers##xdm:adNetwork##meta:enum##reddit##16041",
                "twitter": "core-identifiers##xdm:adNetwork##meta:enum##twitter##20901",
                "adobe_dsp": "core-identifiers##xdm:adNetwork##meta:enum##adobe_dsp##37011",
                "other": "core-identifiers##xdm:adNetwork##meta:enum##other##2871"
              }
            },
            "xdm:network": {
              "type": "string",
              "title": "Network",
              "description": "Alias of adNetwork for migration from GenStudio templates",
              "meta:titleId": "core-identifiers##xdm:network##title##75291",
              "meta:descriptionId": "core-identifiers##xdm:network##description##2601"
            },
            "xdm:accountID": {
              "type": "string",
              "title": "Account ID",
              "description": "Unique identifier for the ad account within the network",
              "meta:titleId": "core-identifiers##xdm:accountID##title##42491",
              "meta:descriptionId": "core-identifiers##xdm:accountID##description##85801"
            },
            "xdm:accountGUID": {
              "type": "string",
              "title": "Account GUID",
              "description": "Unique identifier for the ad account across all networks",
              "meta:titleId": "core-identifiers##xdm:accountGUID##title##25571",
              "meta:descriptionId": "core-identifiers##xdm:accountGUID##description##75291"
            },
            "xdm:campaignID": {
              "type": "string",
              "title": "Campaign ID",
              "description": "Unique identifier for the campaign within the network",
              "meta:titleId": "core-identifiers##xdm:campaignID##title##15331",
              "meta:descriptionId": "core-identifiers##xdm:campaignID##description##43081"
            },
            "xdm:campaignGUID": {
              "type": "string",
              "title": "Campaign GUID",
              "description": "Unique identifier for the campaign across all networks",
              "meta:titleId": "core-identifiers##xdm:campaignGUID##title##59041",
              "meta:descriptionId": "core-identifiers##xdm:campaignGUID##description##13231"
            },
            "xdm:adGroupID": {
              "type": "string",
              "title": "Ad Group ID",
              "description": "Unique identifier for the ad group/ad set/ad squad within the network",
              "meta:titleId": "core-identifiers##xdm:adGroupID##title##11561",
              "meta:descriptionId": "core-identifiers##xdm:adGroupID##description##90251"
            },
            "xdm:adGroupGUID": {
              "type": "string",
              "title": "Ad Group GUID",
              "description": "Unique identifier for the ad group/ad set/ad squad across all networks",
              "meta:titleId": "core-identifiers##xdm:adGroupGUID##title##98381",
              "meta:descriptionId": "core-identifiers##xdm:adGroupGUID##description##79821"
            },
            "xdm:adID": {
              "type": "string",
              "title": "Ad ID",
              "description": "Unique identifier for the individual ad within the network",
              "meta:titleId": "core-identifiers##xdm:adID##title##29091",
              "meta:descriptionId": "core-identifiers##xdm:adID##description##59491"
            },
            "xdm:adGUID": {
              "type": "string",
              "title": "Ad GUID",
              "description": "Unique identifier for the individual ad across all networks",
              "meta:titleId": "core-identifiers##xdm:adGUID##title##37181",
              "meta:descriptionId": "core-identifiers##xdm:adGUID##description##61221"
            },
            "xdm:experienceID": {
              "type": "string",
              "title": "Experience ID",
              "description": "Unique identifier for creative experience (multi-asset compositions) within the network",
              "meta:titleId": "core-identifiers##xdm:experienceID##title##50901",
              "meta:descriptionId": "core-identifiers##xdm:experienceID##description##44491"
            },
            "xdm:experienceGUID": {
              "type": "string",
              "title": "Experience GUID",
              "description": "Unique identifier for creative experience (multi-asset compositions) across all networks",
              "meta:titleId": "core-identifiers##xdm:experienceGUID##title##48101",
              "meta:descriptionId": "core-identifiers##xdm:experienceGUID##description##1631"
            },
            "xdm:assetID": {
              "type": "string",
              "title": "Asset ID",
              "description": "Unique identifier for creative assets (images, videos, etc.) within the network",
              "meta:titleId": "core-identifiers##xdm:assetID##title##37781",
              "meta:descriptionId": "core-identifiers##xdm:assetID##description##26671"
            },
            "xdm:assetGUID": {
              "type": "string",
              "title": "Asset GUID",
              "description": "Unique identifier for creative assets (images, videos, etc.) across all networks",
              "meta:titleId": "core-identifiers##xdm:assetGUID##title##59571",
              "meta:descriptionId": "core-identifiers##xdm:assetGUID##description##15281"
            },
            "xdm:portfolioID": {
              "type": "string",
              "title": "Portfolio ID",
              "description": "Portfolio identifier for grouping campaigns (Amazon Ads and similar platforms) within the network",
              "meta:titleId": "core-identifiers##xdm:portfolioID##title##5841",
              "meta:descriptionId": "core-identifiers##xdm:portfolioID##description##42041"
            },
            "xdm:portfolioGUID": {
              "type": "string",
              "title": "Portfolio GUID",
              "description": "Portfolio identifier for grouping campaigns (Amazon Ads and similar platforms) across all networks",
              "meta:titleId": "core-identifiers##xdm:portfolioGUID##title##18371",
              "meta:descriptionId": "core-identifiers##xdm:portfolioGUID##description##12631"
            },
            "xdm:hierarchyPath": {
              "type": "string",
              "title": "Hierarchy Path",
              "description": "Full hierarchical path showing parent-child relationships (e.g., account_id/campaign_id/adgroup_id/ad_id)",
              "meta:titleId": "core-identifiers##xdm:hierarchyPath##title##42861",
              "meta:descriptionId": "core-identifiers##xdm:hierarchyPath##description##67181"
            },
            "xdm:channel": {
              "type": "string",
              "title": "Channel",
              "description": "Content channel indicating the source of the data (e.g., Web, Mobile, PaidMedia). Used as a reporting dimension for cross-channel breakdowns.",
              "meta:titleId": "core-identifiers##xdm:channel##title##13501",
              "meta:descriptionId": "core-identifiers##xdm:channel##description##66901"
            }
