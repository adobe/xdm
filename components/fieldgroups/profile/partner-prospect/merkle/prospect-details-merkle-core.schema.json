                "xdm:age": {
                  "type": "object",
                  "properties": {
                    "xdm:ageRangeInHousehold": {
                      "type": "integer",
                      "title": "AU004-Age Range In Household",
                      "description": "The age range between the oldest and youngest persons in the household (with 0 meaning either 0 range, or not enough information to determine (i.e. missing age or 1 person Household)).  Ranges from 0-99.",
                      "meta:titleId": "prospect-details-merkle-core##xdm:ageRangeInHousehold##title##59811",
                      "meta:descriptionId": "prospect-details-merkle-core##xdm:ageRangeInHousehold##description##58591"
                    },
                    "xdm:birthdate": {
                      "type": "string",
                      "format": "date-time",
                      "title": "MS073-Birthdate",
                      "description": "Month and year of birth for individual.",
                      "meta:titleId": "prospect-details-merkle-core##xdm:birthdate##title##77631",
                      "meta:descriptionId": "prospect-details-merkle-core##xdm:birthdate##description##72241"
