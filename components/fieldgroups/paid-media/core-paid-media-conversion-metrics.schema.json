  "allOf": [
    {
      "$ref": "#/definitions/conversion-metrics"
    }
  ],
  "meta:status": "stable",
  "meta:titleId": "conversion-metrics##title##89161",
  "meta:descriptionId": "conversion-metrics##description##93491"
}
