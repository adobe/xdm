              "meta:descriptionId": "sports-entertainment-event-schedule##xdm:locationID##description##46611"
            },
            "xdm:eventStartDateTime": {
              "title": "Event Start Datetime",
              "description": "Datetime for the event",
              "type": "string",
              "format": "date-time",
              "meta:titleId": "sports-entertainment-event-schedule##xdm:eventStartDateTime##title##15551",
              "meta:descriptionId": "sports-entertainment-event-schedule##xdm:eventStartDateTime##description##33801"
            },
            "xdm:attractionName": {
