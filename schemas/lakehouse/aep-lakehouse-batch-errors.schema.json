  "$id": "https://ns.adobe.com/xdm/schemas/aep-lakehouse-batch-errors",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "AEP Lakehouse Batch Errors",
  "description": "Global schema for AEP Lakehouse datasets containing batch errors for diagnostics.",
  "type": "object",
  "meta:extensible": false,
  "meta:abstract": false,
  "definitions": {
    "batchErrors": {
      "properties": {
        "xdm:datasetID": {
          "title": "DatasetID",
          "description": "Dataset Id the batch was created for.",
          "type": "string",
          "meta:titleId": "aep-lakehouse-batch-errors##xdm:datasetID##title##45591",
          "meta:descriptionId": "aep-lakehouse-batch-errors##xdm:datasetID##description##28691"
        },
        "xdm:batchID": {
          "title": "BatchID",
          "description": "Id for the batch containing the input files.",
          "type": "string",
          "meta:titleId": "aep-lakehouse-batch-errors##xdm:batchID##title##74131",
          "meta:descriptionId": "aep-lakehouse-batch-errors##xdm:batchID##description##4051"
        },
        "xdm:path": {
          "title": "Path",
          "description": "Path to the input file that contained this record.",
          "type": "string",
          "meta:titleId": "aep-lakehouse-batch-errors##xdm:path##title##81021",
          "meta:descriptionId": "aep-lakehouse-batch-errors##xdm:path##description##72171"
        },
        "xdm:record": {
          "title": "Record",
          "description": "JSON encoded record that failed to process.",
          "type": "string",
          "meta:titleId": "aep-lakehouse-batch-errors##xdm:record##title##68451",
          "meta:descriptionId": "aep-lakehouse-batch-errors##xdm:record##description##83551"
        },
        "xdm:corruptRecord": {
          "title": "CorruptRecord",
          "description": "Original record that failed to process",
          "type": "string",
          "meta:titleId": "aep-lakehouse-batch-errors##xdm:corruptRecord##title##55381",
          "meta:descriptionId": "aep-lakehouse-batch-errors##xdm:corruptRecord##description##12351"
        },
        "xdm:errorType": {
          "title": "ErrorType",
          "description": "Type of error that occurred.",
          "type": "string",
          "enum": ["parse", "conversion", "validation"],
          "meta:enum": {
            "parse": "Parse",
            "conversion": "Conversion",
            "validation": "Validation"
          },
          "meta:titleId": "aep-lakehouse-batch-errors##xdm:errorType##title##36111",
          "meta:descriptionId": "aep-lakehouse-batch-errors##xdm:errorType##description##99711",
          "meta:enumId": {
            "parse": "aep-lakehouse-batch-errors##xdm:errorType##meta:enum##parse##67551",
            "conversion": "aep-lakehouse-batch-errors##xdm:errorType##meta:enum##conversion##85991",
            "validation": "aep-lakehouse-batch-errors##xdm:errorType##meta:enum##validation##50691"
          }
        },
        "xdm:errors": {
          "title": "Errors",
          "description": "Array of errors that caused this record to fail.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "xdm:column": {
                "title": "Column",
                "type": "string",
                "description": "The column that caused the error.",
                "meta:titleId": "aep-lakehouse-batch-errors##xdm:column##title##87231",
                "meta:descriptionId": "aep-lakehouse-batch-errors##xdm:column##description##50341"
              },
              "xdm:code": {
                "title": "Code",
                "type": "string",
                "description": "Standard code for the error.",
