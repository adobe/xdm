                  "type": "number",
                  "title": "Cost Per Lead",
                  "description": "Average cost per lead",
                  "minimum": 0,
                  "meta:titleId": "conversion-metrics##xdm:costPerLead##title##53461",
                  "meta:descriptionId": "conversion-metrics##xdm:costPerLead##description##80381"
                },
                "xdm:leadFormOpens": {
                  "type": "integer",
                  "title": "Lead Form Opens",
                  "description": "Number of times lead form was opened",
                  "minimum": 0,
                  "meta:titleId": "conversion-metrics##xdm:leadFormOpens##title##71371",
                  "meta:descriptionId": "conversion-metrics##xdm:leadFormOpens##description##28651"
                },
                "xdm:leadFormSubmissions": {
                  "type": "integer",
                  "title": "Lead Form Submissions",
                  "description": "Number of lead form submissions",
                  "minimum": 0,
                  "meta:titleId": "conversion-metrics##xdm:leadFormSubmissions##title##17981",
                  "meta:descriptionId": "conversion-metrics##xdm:leadFormSubmissions##description##67301"
