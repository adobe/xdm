              "meta:descriptionId": "content-asset##xdm:version##description##87711"
            },
            "xdm:orientation": {
              "title": "Asset Orientation",
              "type": "string",
              "description": "Asset orientation such as landscape, portrait or square.",
              "meta:enum": {
                "landscape": "Landscape",
                "portrait": "Portrait",
                "square": "Square"
              },
              "meta:titleId": "content-asset##xdm:orientation##title##44481",
              "meta:descriptionId": "content-asset##xdm:orientation##description##20871",
              "meta:enumId": {
                "landscape": "content-asset##xdm:orientation##meta:enum##landscape##88101",
                "portrait": "content-asset##xdm:orientation##meta:enum##portrait##21301",
                "square": "content-asset##xdm:orientation##meta:enum##square##89091"
              }
            },
            "xdm:overallTone": {
              "title": "Asset Overall Tone",
              "type": "string",
              "description": "This gives the overall tone of the image.",
              "meta:enum": {
                "warm": "Warm",
                "cool": "Cool",
                "neutral": "Neutral"
              },
              "meta:titleId": "content-asset##xdm:overallTone##title##14711",
              "meta:descriptionId": "content-asset##xdm:overallTone##description##44871",
