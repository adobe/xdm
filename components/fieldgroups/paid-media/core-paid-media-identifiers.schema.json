              "type": "string",
              "title": "Asset ID",
              "description": "Unique identifier for creative assets (images, videos, etc.) within the network",
              "meta:titleId": "core-identifiers##xdm:assetID##title##90351",
              "meta:descriptionId": "core-identifiers##xdm:assetID##description##82931"
