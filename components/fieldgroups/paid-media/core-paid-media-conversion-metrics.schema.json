                      "description": "Percentage of conversions flagged as fraudulent",
                      "minimum": 0,
                      "maximum": 1,
                      "meta:titleId": "conversion-metrics##xdm:fraudRate##title##81201",
                      "meta:descriptionId": "conversion-metrics##xdm:fraudRate##description##33541"
                    },
                    "xdm:validationRate": {
                      "type": "number",
                      "title": "Validation Rate",
                      "description": "Percentage of conversions that passed validation",
                      "minimum": 0,
                      "maximum": 1,
                      "meta:titleId": "conversion-metrics##xdm:validationRate##title##66031",
                      "meta:descriptionId": "conversion-metrics##xdm:validationRate##description##36411"
                    }
