  "$id": "https://ns.adobe.com/xdm/datatypes/store-web-order",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Store and Web Order",
  "type": "object",
  "description": "The order placed via a store or web portal.",
  "definitions": {
    "store-web-order": {
      "properties": {
        "xdm:orderID": {
          "title": "Order ID",
          "type": "string",
          "description": "Unique identifier assigned by the seller for this order. There is no guarantee that the ID is unique.",
          "meta:titleId": "store-web-order##xdm:orderID##title##94561",
          "meta:descriptionId": "store-web-order##xdm:orderID##description##94011"
        },
        "xdm:orderDate": {
          "title": "Order Date",
          "type": "string",
          "format": "date-time",
          "description": "The date and time when the order was placed.",
          "meta:titleId": "store-web-order##xdm:orderDate##title##52991",
          "meta:descriptionId": "store-web-order##xdm:orderDate##description##19081"
        },
        "xdm:priceTotal": {
          "title": "Price Total",
          "type": "number",
          "description": "The total price of this order after all discounts and taxes have been applied.",
          "meta:titleId": "store-web-order##xdm:priceTotal##title##53411",
          "meta:descriptionId": "store-web-order##xdm:priceTotal##description##46551"
        },
        "xdm:payment": {
          "title": "Payment Details",
          "type": "object",
          "description": "Payment related information.",
          "properties": {
            "xdm:transactionID": {
              "title": "Transaction ID",
              "type": "string",
              "description": "Unique identifier assigned by the payment system.",
              "meta:titleId": "store-web-order##xdm:transactionID##title##58701",
              "meta:descriptionId": "store-web-order##xdm:transactionID##description##19111"
            },
            "xdm:paymentType": {
              "title": "Payment Type",
              "type": "string",
              "description": "Type of payment used.",
              "enum": ["credit", "debit", "gift", "cash"],
              "meta:enum": {
                "credit": "Credit",
                "debit": "Debit",
                "gift": "Gift",
                "cash": "Cash"
              },
              "meta:titleId": "store-web-order##xdm:paymentType##title##21561",
              "meta:descriptionId": "store-web-order##xdm:paymentType##description##5301",
              "meta:enumId": {
                "credit": "store-web-order##xdm:paymentType##meta:enum##credit##34811",
                "debit": "store-web-order##xdm:paymentType##meta:enum##debit##60991",
                "gift": "store-web-order##xdm:paymentType##meta:enum##gift##3551",
                "cash": "store-web-order##xdm:paymentType##meta:enum##cash##59111"
              }
            },
            "xdm:paymentAmount": {
              "title": "Payment Amount",
              "type": "number",
              "description": "Unique identifier assigned by the payment system.",
              "meta:titleId": "store-web-order##xdm:paymentAmount##title##18811",
              "meta:descriptionId": "store-web-order##xdm:paymentAmount##description##3701"
            },
            "xdm:currencyCode": {
              "title": "Currency",
              "type": "string",
              "examples": ["USD", "EUR"],
              "pattern": "^[A-Z]{3}$",
              "description": "The ISO 4217 currency code used for the order totals.",
              "meta:titleId": "store-web-order##xdm:currencyCode##title##15721",
              "meta:descriptionId": "store-web-order##xdm:currencyCode##description##19291"
            }
          },
          "meta:titleId": "store-web-order##xdm:payment##title##45321",
          "meta:descriptionId": "store-web-order##xdm:payment##description##42821"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/store-web-order"
    }
  ],
  "meta:status": "experimental",
  "meta:titleId": "store-web-order##title##82181",
  "meta:descriptionId": "store-web-order##description##50951"
}
